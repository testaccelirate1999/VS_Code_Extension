{
  "name": "dev-agent",
  "displayName": "Flow Agent \u2014 Accelirate's MuleSoft Assistant",
  "description": "AI-powered RAML, DataWeave and Mule Flow generation directly in VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devAgent",
          "title": "Flow Agent",
          "icon": "media/sidebar.png"
        }
      ]
    },
    "views": {
      "devAgent": [
        {
          "type": "webview",
          "id": "devAgent.chatView",
          "name": "Accelirate's MuleSoft Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "devAgent.openChat",
        "title": "Flow Agent: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devAgent.newSession",
        "title": "Flow Agent: New Project Session"
      },
      {
        "command": "devAgent.startServer",
        "title": "Flow Agent: Start Server"
      }
    ],
    "configuration": {
      "title": "Flow Agent",
      "properties": {
        "devAgent.serverUrl": {
          "type": "string",
          "default": "http://localhost:8001",
          "description": "URL of the Flow Agent Python server"
        },
        "devAgent.outputFolder": {
          "type": "string",
          "default": "",
          "description": "Subfolder inside workspace to write generated files. Leave empty for workspace root."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "icon": "media/chat.png"
}